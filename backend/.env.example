NODE_ENV=development
PORT=5000
DATABASE_URL=postgresql://postgres:postgres@localhost:5432/magra_school
# Generate a long random value for production (32+ characters; preferably 64+)
JWT_SECRET=REPLACE_WITH_A_LONG_RANDOM_SECRET
# Comma-separated exact frontend origins; never use * in production
CORS_ORIGIN=http://localhost:5173
TRUST_PROXY=false
